FROM n8nio/n8n:latest

USER root

COPY package.json /custom-nodes/@fixtse/n8n-nodes-prodex/package.json
COPY dist /custom-nodes/@fixtse/n8n-nodes-prodex/dist
COPY scripts/device-code-bootstrap.mjs /custom-nodes/@fixtse/n8n-nodes-prodex/scripts/device-code-bootstrap.mjs
RUN cd /custom-nodes/@fixtse/n8n-nodes-prodex && npm install --omit=dev

ENV N8N_CUSTOM_EXTENSIONS=/custom-nodes

USER node
